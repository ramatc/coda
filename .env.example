# Coda — Fase 0 environment template.
# Copy to .env and fill in local values. No cloud-provider credentials belong here.

# Runtime
NODE_ENV=development

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
# Base URL the web app uses to call the API (defaults to http://localhost:4000 when unset)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (local docker-compose Postgres — see docker-compose.yml in PR2)
DATABASE_URL=postgresql://coda:coda@localhost:5432/coda?schema=public
DIRECT_URL=postgresql://coda:coda@localhost:5432/coda?schema=public

# Redis (local docker-compose Redis — see docker-compose.yml in PR2)
REDIS_URL=redis://localhost:6379

# Clerk (auth — wired in PR4; use your Clerk dev instance keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Svix signing secret of the Clerk webhook endpoint (whsec_...); the webhook rejects requests when empty
CLERK_WEBHOOK_SECRET=

# Meilisearch (local docker-compose; MEILI_HOST defaults to http://localhost:7700 when unset)
MEILI_HOST=http://localhost:7700
# Local-dev value matching docker-compose.yml; production uses a real secret
MEILI_MASTER_KEY=coda_dev_master_key

# Avatar storage (Cloudflare R2; avatar uploads fail when these are empty)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for stored avatars, no trailing slash
R2_PUBLIC_BASE=

# Catalog import admins: comma-separated Clerk user ids; the import endpoint is disabled when empty
CATALOG_ADMIN_USER_IDS=

# Catalog import sources (required to run imports; client-credentials app for Spotify)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# MusicBrainz requires an identifying User-Agent, e.g. "Coda/0.1 (you@example.com)"
MUSICBRAINZ_USER_AGENT=

# Notification emails (optional; sending is disabled when either is empty)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
